    "household": "multi-user data sharing: define who can see/change what, invites and removal",
    "magic link": "email sign-in needs real email delivery (or a dev inbox in development)",
    "testing": "check the plan's testing statement against the rule 'every change ships with tests'",
}


def count_hits(text, phrases):
    n = 0
    for p in phrases:
        p = p.strip().lower()
        if p and re.search(r"(?<![a-z0-9])" + re.escape(p) + r"(?![a-z0-9])", text):
            n += 1
    return n


def cover_teams(archetypes, teams):
    """smallest set of teams whose `fits` cover the archetypes (greedy)"""
    full, remaining = [], set(archetypes)
    while remaining:
        best = max((t for t in teams.values() if t["id"] not in ("starter", "setup")),
                   key=lambda t: len(remaining & set(as_list(t.get("fits")))), default=None)
        if not best or not (remaining & set(as_list(best.get("fits")))):
            break
        full.append(best["id"])
        remaining -= set(as_list(best.get("fits")))
    return full


def recommend(idea, fw=FW):
    text = " " + idea.lower() + " "
    arch, caps = catalog(fw)
    teams = load_dir("teams", fw)
    scores = {a: count_hits(text, kw.split(",")) for a, kw in ARCH_KEYWORDS.items() if a in arch}
    chosen = [a for a, s in sorted(scores.items(), key=lambda x: -x[1]) if s > 0][:3]
    cap_hits = [c for c, v in caps.items() if count_hits(text, v["triggers"]) > 0 and c not in ALWAYS_ON_CAPS]
    # sensible implications
    if "mobile-app" in chosen and ({"authentication", "database", "payments", "email-and-notifications", "file-uploads", "search"} & set(cap_hits) or "fullstack-app" in chosen) and "api-service" not in chosen:
        chosen.append("api-service")
    if "fullstack-app" in chosen:  # one project that already contains its screens and its API
        for covered in ("web-app", "api-service"):
            if covered in chosen and "mobile-app" not in chosen:
                chosen.remove(covered)
    if "ai-assistant" in chosen and "chat-bot" in chosen and scores.get("chat-bot", 0) <= 1 and not re.search(r"slack|discord|telegram|teams|whatsapp", text):
        chosen.remove("chat-bot")
    confident = bool(chosen)
    if "fullstack-app" in chosen or "api-service" in chosen:
        for c in ("authentication", "database"):
            if c not in cap_hits and "fullstack-app" in chosen:
                cap_hits.append(c)
    also = [a for a, sc in sorted(scores.items(), key=lambda x: -x[1]) if sc > 0 and a not in chosen
            and not (a in ("web-app", "api-service") and "fullstack-app" in chosen)][:3]
    risks = []
    for phrase, note in RISK_FLAGS.items():
        if re.search(r"(?<![a-z0-9])" + re.escape(phrase), text) and note not in risks:
            risks.append(note)
    return {"archetypes": chosen, "also_mentioned": also, "capabilities": cap_hits, "lean_team": "starter",
            "full_teams": cover_teams(chosen, teams) or ["starter"], "confident": confident, "risk_flags": risks,
            "always_on": ALWAYS_ON_CAPS}


# ----------------------------------------------------------------------------- roster
def load_custom_teams(proj):
    """teams defined by the project itself: .autocraft/custom/teams/<id>.md (same format as teams/*.md)"""
    out = {}
    d = Path(proj) / ".autocraft" / "custom" / "teams"
    for f in sorted(d.glob("*.md")) if d.is_dir() else []:
        meta, body = parse_md(f)
        meta.setdefault("id", f.stem)
        meta.setdefault("name", meta["id"])
        meta.setdefault("summary", "Project-defined team")
        meta["body"], meta["path"] = body, f
        out[meta["id"]] = meta
    return out


def resolve_team_ids(cfg, fw=FW, proj=None):
    teams = load_dir("teams", fw)
    if proj is not None:
        teams.update(load_custom_teams(proj))
    ids = as_list(cfg.get("team")) or ["starter"]
    for t in ids:
        if t not in teams:
            raise SystemExit(f"error: unknown team '{t}'. Known: {', '.join(teams)}")
    return ids, teams


def resolve_roster(cfg, proj, fw=FW):
    roles = load_dir("roles", fw)
    custom = proj / ".autocraft" / "custom" / "roles"
    for f in sorted(custom.glob("*.md")) if custom.is_dir() else []:
        if f.name.endswith(".append.md"):
            continue
        meta, body = parse_md(f)
        meta.setdefault("id", f.stem)
        meta["body"], meta["path"], meta["custom"] = body, f, True
        roles[meta["id"]] = meta
    team_ids, teams = resolve_team_ids(cfg, fw, proj)
    ids = []
    for t in team_ids:
        for r in as_list(teams[t].get("roles")):
            if r not in ids:
                ids.append(r)
    for r in as_list(cfg.get("roles_add")):
        if r not in ids:
            ids.append(r)
    ids = [r for r in ids if r not in as_list(cfg.get("roles_remove"))]
    for r in ids:
        if r not in roles:
            raise SystemExit(f"error: unknown role '{r}'. Known: {', '.join(roles)}")
    wf_all = load_dir("workflows", fw)
    have = set(ids)
    ok = lambda w: set(as_list(wf_all[w].get("needs"))) <= have  # workflow's required roles are all present
    wf = []
    for t in team_ids:
        for w in as_list(teams[t].get("workflows")):
            if w in wf_all and w not in wf and ok(w):
                wf.append(w)
    for w in wf_all:  # roles you add switch on their workflows
        if w not in wf and as_list(wf_all[w].get("needs")) and ok(w):
            wf.append(w)
    for w in (proj / ".autocraft" / "custom" / "workflows").glob("*.md") if (proj / ".autocraft" / "custom" / "workflows").is_dir() else []:
        meta, body = parse_md(w)
        meta.setdefault("id", w.stem)
        meta["body"], meta["path"] = body, w
        wf_all[meta["id"]] = meta
        if meta["id"] not in wf:
            wf.append(meta["id"])
    return [roles[r] for r in ids], [wf_all[w] for w in wf], [teams[t] for t in team_ids]


def read_custom(proj, rel):
    p = proj / ".autocraft" / "custom" / rel
    if not p.exists():
        return ""
    return re.sub(r"<!--.*?-->", "", p.read_text(), flags=re.S).strip()  # HTML comments are notes, not rules


GIT_MODES = {
    "session-branch": ("work on the branch the session started on; do NOT create or push other remote branches and do NOT open pull requests unless the "
                       "owner asks. Parallel tasks use LOCAL `git worktree` branches (`feat/<task>`, never pushed) that the main session merges into the "
                       "session branch with `git merge --no-ff` once the reviewer approved. Handoffs/reviews are files under `.autocraft/work/<task>/`, "
                       "committed on the session branch. Push the session branch regularly (`git push -u origin HEAD`, retry on network errors) so work "
                       "survives the session ending. 'Humans merge' means: nothing reaches `main` until the owner merges the session branch's pull request."),
    "pr-per-task": ("each task on its own branch `feat/<task>`, pushed, with its own pull request and `agent:*` labels (protocol sections 3-4); reviews "
                    "are PR reviews/comments; the owner merges every pull request."),
}


def effective_body(role, cfg, proj, roster, archetypes, capabilities, team_names):
    exp = cfg.get("experience") or "beginner"
    body = role["body"]
    append = read_custom(proj, f"roles/{role['id']}.append.md")
    team_rules = read_custom(proj, "team-rules.md")
    sources = as_list(cfg.get("sources"))
    git_mode = cfg.get("git_mode") or "session-branch"
    colleagues = "\n".join(f"  - `{r['id']}`: {first_sentence(r.get('description', ''), 110)}" for r in roster if r["id"] != role["id"])
    ctx = [
        "## Project context (generated by autocraft)",
        f"- **Team:** {', '.join(team_names)}. You are `{role['id']}`. Colleagues you hand off to or receive from:\n{colleagues}",
        f"- **Software type (archetypes):** {', '.join(archetypes) or 'not chosen yet - run the `discover` workflow'}"
        + ("; read each profile in `.autocraft/archetypes/<name>.md` and apply it." if archetypes else "."),
        f"- **Capabilities in play:** {', '.join(capabilities)}; read each in `.autocraft/capabilities/<name>.md`: apply its *Safe defaults*, "
        "test its *Must test* list, avoid its *Common mistakes*, prefer what it says not to build yourself.",
        f"- **Audience (`experience: {exp}`):** {EXPERIENCE.get(exp, EXPERIENCE['beginner'])} Whatever the level: never lower quality gates, tests, "
        "security checks, independent review or the human merge gate.",
        "- **Protocol:** handoffs, severity tags, labels, review rounds and human gates are in `.autocraft/protocol.md`. "
        f"Limits: {cfg.get('max_review_rounds', 3)} review rounds, {cfg.get('max_parallel_developers', 3)} parallel developers, autonomy level {cfg.get('autonomy_level', 2)}.",
        "- **Collaboration surface:** use GitHub pull requests and labels when the project has them; otherwise exchange reviews as files under "
        "`.autocraft/work/<task>/` (see protocol section 12).",
        f"- **Git mode (`git_mode: {git_mode}`):** {GIT_MODES.get(git_mode, GIT_MODES['session-branch'])}",
        "- **GitHub operations:** use the `gh` CLI if it is installed. If it is not (for example in Claude app / cloud sessions), use the session's "
        "GitHub tools instead; the operation-by-operation mapping is in `.autocraft/protocol.md` section 13.",
    ]
    if sources:
        ctx.insert(2, "- **Owner's source documents (authoritative inputs; read them before anything else):** " + ", ".join(f"`{x}`" for x in sources)
                   + ". They express the owner's intent. Do not silently contradict or embellish them: record gaps, ambiguities and contradictions as numbered "
                   "questions with a recommended default, and trace what you produce back to the section it came from.")
    if team_rules:
        ctx += ["", "### Team rules (project-specific)", team_rules]
    if append:
        ctx += ["", f"### Extra rules for `{role['id']}` (project-specific)", append]
    lines = body.split("\n")
    for i, l in enumerate(lines):
        if l.startswith("# "):
            return "\n".join(lines[: i + 1]) + "\n\n" + "\n".join(ctx) + "\n\n" + "\n".join(lines[i + 1:]).lstrip("\n")
    return "\n".join(ctx) + "\n\n" + body


# ----------------------------------------------------------------------------- exporters
RULES = """## Non-negotiable rules
1. Never commit to `main`; all changes go through a pull request (or a reviewed branch). **Never merge - humans merge.**
2. Every behavior change ships with unit tests, and integration tests when it crosses a boundary (database, network, queue).
3. Never commit secrets. Never disable or skip a test, check or protection to get green.
4. `docs/architecture/` is the source of truth; declare any deviation in the PR.
5. Review feedback uses severity tags `[BLOCKER] [MAJOR] [MINOR] [NIT] [QUESTION]`; blockers and majors must be resolved before approval.
6. After the configured number of review rounds, stop and ask the human (`needs-human`).
7. Hand off with the block in `.autocraft/protocol.md`; keep `docs/STATUS.md` current. State lives in the repo, not in chat memory."""


def hats_text(tool):
    if tool in ROLE_HATS_TOOLS:
        return ("**This tool has no true sub-agents, so you run the team as role hats:** work one role at a time, announce "
                "`Acting as: <role>`, and read that role's file first. **Use a fresh chat/session for every reviewing role** "
                "(`pr-reviewer`, `principal-engineer`, `release-gatekeeper`, `qa-engineer`) and give it only the diff, the spec and the "
                "protocol - not the author's reasoning - so the review is genuinely independent. Pass work between roles through files "
                "(specs, reviews, `docs/STATUS.md`), not memory.")
    if tool == "claude-code":
        return ("Roles are Claude Code subagents with their own context. **You, the main session, are the team lead.**\n"
                "- Delegate with the Agent tool using `subagent_type` = the role id (e.g. `architect`). If a role is not listed as an agent type yet "
                "(its file was created this session), start a `general-purpose` agent and tell it to read `.claude/agents/<role>.md` first and follow it.\n"
                "- Subagents cannot call subagents: run the loops yourself (author -> reviewer -> author) and enforce the round limit.\n"
                "- Run independent tasks **in parallel** (background agents, each in its own `git worktree`); reviewers are always a **fresh agent** that "
                "never sees the author's reasoning and must run the tests itself.\n"
                "- Do not poll agents; wait for their completion notifications. After every step update `docs/STATUS.md` and commit.\n"
                "- When you need the owner (a gate, a decision, a deadlock, release-ready) say exactly what you need, with a recommended default, at the "
                "end of your message; if a push-notification tool is available, send one.\n"
                "- The owner asking you to use this team is authorization to spawn these agents. Keep a lean start: do not spawn roles a task does not need.")
    return ("Roles run as separate agents with their own context. A role cannot call another role; the main session coordinates the "
            "loops (author -> reviewer -> author) and enforces the round limit.")


def team_guide(tool, cfg, roster, workflows, teams, role_ref, wf_ref, archetypes, capabilities):
    rows = "\n".join(f"| `{r['id']}` | {first_sentence(r.get('description', ''), 130)} | {role_ref(r)} |" for r in roster)
    wf = "\n".join(f"- {wf_ref(w)} - {first_sentence(w.get('description', ''), 130)}" for w in workflows)
    playbooks = "\n\n".join(t["body"].strip() for t in teams)
    team_rules = read_custom(Path(cfg["_proj"]), "team-rules.md")
    return f"""# Agent team (managed by autocraft)

This project is built by a **team of role-specialised AI agents** working with a human owner. Teams: **{', '.join(t['name'] for t in teams)}**.
Software type: {', '.join(archetypes) or '(not chosen yet - run `discover`)'} - Capabilities: {', '.join(capabilities)} - Audience level: {cfg.get('experience', 'beginner')}.

## Roles
| Role | What it does | How to invoke |
|---|---|---|
{rows}

## Workflows
{wf}

## How to run the team in this tool
{hats_text(tool)}

{playbooks}

{RULES}

## Where things live
Specs `docs/specs/` - architecture `docs/architecture/` (+`status.md`) - decisions `docs/adr/` - design `docs/design/` - status `docs/STATUS.md` -
config `.autocraft/config.yml` - archetypes `.autocraft/archetypes/` - capabilities `.autocraft/capabilities/` - protocol `.autocraft/protocol.md` -
customizations `.autocraft/custom/` (edit these, then `autocraft sync`).
{('' if not team_rules else chr(10) + '## Team rules' + chr(10) + team_rules)}
"""


def toml_prompt(s):
    return "'''\n" + s.replace("'''", "' ' '") + "\n'''"


def export(tool, ctx):
    """returns (files: {relpath: text}, blocks: {relpath: text})"""
    cfg, roster, wfs, teams = ctx["cfg"], ctx["roster"], ctx["workflows"], ctx["teams"]
    eff = ctx["eff"]  # role id -> effective body
    A, C = ctx["archetypes"], ctx["capabilities"]
    files, blocks = {}, {}
    gen = lambda src: f"<!-- Generated by autocraft from {src}. Do not edit: customize in .autocraft/custom/ and run `autocraft sync`. -->"

    def guide(role_ref, wf_ref):
        return team_guide(tool, cfg, roster, wfs, teams, role_ref, wf_ref, A, C)

    def wf_body(w):
        pre = ("> Roles named below are separate agents in this tool." if tool in ("claude-code", "copilot") else
               "> This tool has no sub-agents: wherever this says 'delegate to <role>' / 'invoke <role>', **switch hats** to that role "
               "(read `.autocraft/roles/<role>.md` or its rule) and use a fresh session for reviewers.")
        return f"{pre}\n\n{w['body'].strip()}\n"

    if tool == "claude-code":
        models = role_models(cfg)
        for r in roster:
            ab = as_list(r.get("abilities"))
            tl = []
            for a in ab:
                tl += {"read": ["Read"], "search": ["Grep", "Glob"], "write": ["Write"], "edit": ["Edit"], "shell": ["Bash"]}.get(a, [])
            files[f".claude/agents/{r['id']}.md"] = (f"---\nname: {r['id']}\ndescription: {yq(r.get('description', ''))}\n"
                                                    f"tools: {', '.join(dict.fromkeys(tl))}\nmodel: {models.get(r['id']) or r.get('model') or 'inherit'}\n---\n{gen('roles/' + r['id'] + '.md')}\n\n{eff[r['id']]}")
        for w in wfs:
            files[f".claude/skills/{w['id']}/SKILL.md"] = f"---\nname: {w['id']}\ndescription: {yq(w.get('description', ''))}\n---\n{gen('workflows/' + w['id'] + '.md')}\n\n{wf_body(w)}"
        blocks["CLAUDE.md"] = guide(lambda r: f"subagent `{r['id']}`", lambda w: f"`/{w['id']}`")
    elif tool == "claude-app":
        base = "claude-project"
        files[f"{base}/INSTRUCTIONS.md"] = f"""# Paste this into your Claude Project's instructions

You are the **Team Lead** of an AI software team working with me (the human owner) inside this chat. You can play every role in the
team in turn. The role descriptions, workflows and rules are in the project knowledge files: `roles.md`, `workflows.md`, `protocol.md`,
`archetypes.md`, `capabilities.md`.

How to work:
1. When I start (or say `/start`), run the **start** workflow from `workflows.md`. Ask me at most a few questions at a time, each with a default.
2. Work **one role at a time**. Announce `Acting as: <role>`, follow that role's section in `roles.md`, and finish with the handoff block from `protocol.md`.
3. For anything that reviews (pr-reviewer, principal-engineer, release-gatekeeper, qa-engineer): say you are switching to a *reviewer* and review only what is on the page (spec + code), as if you had not written it. Be strict. For real independence, I may open a new chat and paste the artifact.
4. Keep a short **STATUS** block at the end of each reply: phase, done, next, what I need to do.
5. Produce files as separate code blocks with their paths so I can save them into the repo. You cannot run code or tests here; say so, and give me the exact commands to run. For hands-on repo work with tests and PRs, use Claude Code (desktop, terminal, web or the Claude app's code sessions) with the `claude-code` export.
6. Audience level is **{cfg.get('experience', 'beginner')}**: {EXPERIENCE.get(cfg.get('experience', 'beginner'), EXPERIENCE['beginner'])}
7. {RULES.splitlines()[1][3:]} Never lower quality gates; I merge and release.

Team: {', '.join(t['name'] for t in teams)}. Software type: {', '.join(A) or 'not chosen yet - run discover'}.

{hats_text('claude-app')}
"""
        files[f"{base}/knowledge/roles.md"] = "# Roles\n\n" + "\n\n---\n\n".join(eff[r["id"]] for r in roster)
        files[f"{base}/knowledge/workflows.md"] = "# Workflows\n\n" + "\n\n---\n\n".join(f"## {w['id']}\n\n{wf_body(w)}" for w in wfs)
        files[f"{base}/knowledge/protocol.md"] = ctx["protocol"]
        files[f"{base}/knowledge/archetypes.md"] = "# Software-type profiles\n\n" + "\n\n---\n\n".join(a.read_text() for a in ctx["arch_files"]) if ctx["arch_files"] else "# Software-type profiles\n\nNone chosen yet - run discover.\n"
        files[f"{base}/knowledge/capabilities.md"] = "# Capabilities\n\n" + "\n\n---\n\n".join(c.read_text() for c in ctx["cap_files"])
    elif tool == "cursor":
        files[".cursor/rules/autocraft-team.mdc"] = f"---\ndescription: {yq('The AI agent team for this project: roles, workflows and rules')}\nalwaysApply: true\n---\n{gen('team guide')}\n\n" + guide(lambda r: f"rule `role-{r['id']}` (@-mention it)", lambda w: f"rule `workflow-{w['id']}`")
        for r in roster:
            files[f".cursor/rules/role-{r['id']}.mdc"] = f"---\ndescription: {yq(r.get('description', ''))}\nalwaysApply: false\n---\n{gen('roles/' + r['id'] + '.md')}\n\n{eff[r['id']]}"
        for w in wfs:
            files[f".cursor/rules/workflow-{w['id']}.mdc"] = f"---\ndescription: {yq(w.get('description', ''))}\nalwaysApply: false\n---\n{gen('workflows/' + w['id'] + '.md')}\n\n{wf_body(w)}"
    elif tool == "copilot":
        for r in roster:
            tl = []
            for a in as_list(r.get("abilities")):
                tl += {"read": ["read"], "search": ["search"], "write": ["edit"], "edit": ["edit"], "shell": ["execute"]}.get(a, [])
            tl = list(dict.fromkeys(tl))
            files[f".github/agents/{r['id']}.agent.md"] = (f"---\nname: {r['id']}\ndescription: {yq(r.get('description', ''))}\n"
                                                           f"tools: [{', '.join(yq(t) for t in tl)}]\n---\n{gen('roles/' + r['id'] + '.md')}\n\n{eff[r['id']]}")
        for w in wfs:
            files[f".github/prompts/{w['id']}.prompt.md"] = f"---\nmode: agent\ndescription: {yq(w.get('description', ''))}\n---\n{gen('workflows/' + w['id'] + '.md')}\n\n{wf_body(w)}"
        blocks[".github/copilot-instructions.md"] = guide(lambda r: f"custom agent `{r['id']}` (agent picker)", lambda w: f"prompt `/{w['id']}`")
    elif tool == "gemini-cli":
        blocks["GEMINI.md"] = guide(lambda r: f"read `.autocraft/roles/{r['id']}.md`", lambda w: f"`/{w['id']}` or `.autocraft/workflows/{w['id']}.md`")
        for w in wfs:
            files[f".gemini/commands/{w['id']}.toml"] = (f"# Generated by autocraft from workflows/{w['id']}.md - customize in .autocraft/custom/ and run `autocraft sync`.\n"
                                                          f"description = {yq(first_sentence(w.get('description', ''), 200))}\nprompt = {toml_prompt(wf_body(w) + chr(10) + 'User input: {{args}}')}\n")
    elif tool == "windsurf":
        files[".windsurf/rules/autocraft-team.md"] = f"---\ntrigger: always_on\ndescription: {yq('Project AI agent team')}\n---\n{gen('team guide')}\n\n" + guide(lambda r: f"rule `role-{r['id']}`", lambda w: f"rule `workflow-{w['id']}` (invoke manually)")
        for r in roster:
            files[f".windsurf/rules/role-{r['id']}.md"] = f"---\ntrigger: model_decision\ndescription: {yq(r.get('description', ''))}\n---\n{gen('roles/' + r['id'] + '.md')}\n\n{eff[r['id']]}"
        for w in wfs:
            files[f".windsurf/rules/workflow-{w['id']}.md"] = f"---\ntrigger: manual\ndescription: {yq(w.get('description', ''))}\n---\n{gen('workflows/' + w['id'] + '.md')}\n\n{wf_body(w)}"
    elif tool == "cline":
        files[".clinerules/autocraft-team.md"] = gen("team guide") + "\n\n" + guide(lambda r: f"read `.autocraft/roles/{r['id']}.md`", lambda w: f"read `.autocraft/workflows/{w['id']}.md`")
    elif tool == "agents-md":
        blocks["AGENTS.md"] = guide(lambda r: f"read `.autocraft/roles/{r['id']}.md`", lambda w: f"read `.autocraft/workflows/{w['id']}.md`")
    elif tool == "prompts":
        files["prompts/00-team-lead.md"] = (f"# Team Lead prompt\n\nPaste this first, then paste (or attach) the role file you need.\n\n" + guide(lambda r: f"`prompts/{r['id']}.md`", lambda w: f"`prompts/workflows/{w['id']}.md`"))
        for r in roster:
            files[f"prompts/{r['id']}.md"] = eff[r["id"]]
        for w in wfs:
            files[f"prompts/workflows/{w['id']}.md"] = wf_body(w)
    else:
        raise SystemExit(f"error: unknown tool '{tool}'. Known: {', '.join(TOOLS)}")
    if tool in NEEDS_NEUTRAL_COPIES:
        for r in roster:
            files[f".autocraft/roles/{r['id']}.md"] = f"{gen('roles/' + r['id'] + '.md')}\n\n{eff[r['id']]}"
        for w in wfs:
            files[f".autocraft/workflows/{w['id']}.md"] = f"{gen('workflows/' + w['id'] + '.md')}\n\n{wf_body(w)}"
    return files, blocks


