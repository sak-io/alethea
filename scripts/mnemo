#!/usr/bin/env python3
"""mnemo launcher: resolves symlinks, then delegates to engram.cli (stdlib only)."""
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.realpath(__file__))))
from engram.cli import main  # noqa: E402

if __name__ == "__main__":
    sys.exit(main())
