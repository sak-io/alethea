{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "/ABSOLUTE/PATH/TO/python",
            "args": [
              "-m",
              "engram.hooks.engram_hook"
            ],
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/ABSOLUTE/PATH/TO/python",
            "args": [
              "-m",
              "engram.hooks.engram_hook"
            ],
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/ABSOLUTE/PATH/TO/python",
            "args": [
              "-m",
              "engram.hooks.engram_hook"
            ],
            "timeout": 5
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/ABSOLUTE/PATH/TO/python",
            "args": [
              "-m",
              "engram.hooks.engram_hook"
            ],
            "timeout": 3
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/ABSOLUTE/PATH/TO/python",
            "args": [
              "-m",
              "engram.hooks.engram_hook"
            ],
            "timeout": 5
          }
        ]
      }
    ]
  }
}
